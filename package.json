{
  "name": "pi-multi-orchestrator",
  "version": "0.1.0-rc.19",
  "description": "Pi control center for bounded 9Router model, pool, mission, quality, analytics, and safety workflows",
  "type": "module",
  "keywords": ["pi-package"],
  "files": [
    "dist/**/*.js",
    "dist/**/*.d.ts",
    "README.md",
    "docs/OPERATOR_GUIDE.md"
  ],
  "exports": {
    "./config": {
      "types": "./dist/core/config/index.d.ts",
      "import": "./dist/core/config/index.js"
    },
    "./ninerouter": {
      "types": "./dist/core/ninerouter/index.d.ts",
      "import": "./dist/core/ninerouter/index.js"
    },
    "./pools": {
      "types": "./dist/core/pools/index.d.ts",
      "import": "./dist/core/pools/index.js"
    },
    "./routing": {
      "types": "./dist/core/routing/index.d.ts",
      "import": "./dist/core/routing/index.js"
    },
    "./health": {
      "types": "./dist/core/health/index.d.ts",
      "import": "./dist/core/health/index.js"
    },
    "./workers": {
      "types": "./dist/core/workers/index.d.ts",
      "import": "./dist/core/workers/index.js"
    },
    "./missions": {
      "types": "./dist/core/mission/index.d.ts",
      "import": "./dist/core/mission/index.js"
    },
    "./context": {
      "types": "./dist/core/context/index.d.ts",
      "import": "./dist/core/context/index.js"
    },
    "./analytics": {
      "types": "./dist/core/analytics/index.d.ts",
      "import": "./dist/core/analytics/index.js"
    },
    "./smart-routing": {
      "types": "./dist/core/smart-routing/index.d.ts",
      "import": "./dist/core/smart-routing/index.js"
    },
    "./routing-memory": {
      "types": "./dist/core/routing-memory/index.d.ts",
      "import": "./dist/core/routing-memory/index.js"
    },
    "./security": {
      "types": "./dist/core/security/index.d.ts",
      "import": "./dist/core/security/index.js"
    },
    "./quality": {
      "types": "./dist/core/quality/index.d.ts",
      "import": "./dist/core/quality/index.js"
    },
    "./pi": {
      "types": "./dist/host/pi-extension.d.ts",
      "import": "./dist/host/pi-extension.js"
    }
  },
  "pi": {
    "extensions": ["./dist/host/pi-extension.js"]
  },
  "scripts": {
    "clean": "node -e \"const fs=require('node:fs'); for (const path of ['dist','dist-test']) fs.rmSync(path,{recursive:true,force:true})\"",
    "clean:test": "node -e \"require('node:fs').rmSync('dist-test',{recursive:true,force:true})\"",
    "build": "node node_modules/typescript/lib/tsc.js -p tsconfig.build.json",
    "typecheck": "node node_modules/typescript/lib/tsc.js -p tsconfig.json",
    "test": "npm run clean:test && node node_modules/typescript/lib/tsc.js -p tsconfig.test.json && node --test dist-test/test/*.test.js",
    "check": "npm run typecheck && npm test && npm run build",
    "release:candidate": "node scripts/release-candidate.mjs",
    "release:verify": "node scripts/run-release-verification.mjs"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": ">=0.84.1 <0.85.0"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "0.84.1",
    "@types/node": "24.12.4",
    "typescript": "5.9.3"
  }
}
